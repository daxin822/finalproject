apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    control-plane.finalproject/workload: inference
    {{- range $k, $v := .Labels }}
    {{ $k }}: {{ quote $v }}
    {{- end }}
  annotations:
    control-plane.finalproject/extended-resource: {{ quote .ExtendedRes }}
    {{- range $k, $v := .Annotations }}
    {{ $k }}: {{ quote $v }}
    {{- end }}
spec:
  replicas: {{ .Replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Name }}
        control-plane.finalproject/workload: inference
        {{- range $k, $v := .Labels }}
        {{ $k }}: {{ quote $v }}
        {{- end }}
    spec:
      {{- if .NodeSelector }}
      nodeSelector:
        {{- range $k, $v := .NodeSelector }}
        {{ $k }}: {{ quote $v }}
        {{- end }}
      {{- end }}
      containers:
      - name: infer
        image: {{ quote .Image }}
        {{- if .Command }}
        command:
        {{- range .Command }}
        - {{ quote . }}
        {{- end }}
        {{- end }}
        {{- if .Args }}
        args:
        {{- range .Args }}
        - {{ quote . }}
        {{- end }}
        {{- end }}
        ports:
        - containerPort: {{ .Port }}
          name: http
        resources:
          limits:
            {{ .ExtendedRes }}: {{ quote .ResQuantity }}
          {{- if .ResourceRequests }}
          requests:
            {{- range $k, $v := .ResourceRequests }}
            {{ $k }}: {{ quote $v }}
            {{- end }}
          {{- else }}
          requests:
            {{ .ExtendedRes }}: {{ quote .ResQuantity }}
          {{- end }}
        volumeMounts:
        - name: ascend-driver
          mountPath: /usr/local/Ascend/driver
          readOnly: true
      volumes:
      - name: ascend-driver
        hostPath:
          path: /usr/local/Ascend/driver
          type: DirectoryOrCreate
{{- if .CreateService }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Name }}
spec:
  type: {{ quote .ServiceType }}
  selector:
    app.kubernetes.io/name: {{ .Name }}
  ports:
  - name: http
    port: {{ .Port }}
    targetPort: {{ .Port }}
{{- end }}
